# Telemetry agent for the robot's own Jetson.
#   sudo cp systemd/robot-telemetry-agent.service /etc/systemd/system/
#   sudo systemctl enable --now robot-telemetry-agent
[Unit]
Description=Robot telemetry -> Splunk HEC
After=network-online.target
Wants=network-online.target
# These belong in [Unit], NOT [Service]: systemd 245 warns "Unknown key name" and ignores
# them if placed under [Service], leaving the crash-loop guard silently disabled.
StartLimitBurst=5
StartLimitIntervalSec=120

[Service]
User=unitree
WorkingDirectory=/home/unitree/robot-telemetry-agent
Environment=HEC_URL=https://192.168.20.200:8088/services/collector/event
Environment=HEC_INDEX=go2-robot-data
Environment=ROBOT_NAME=go2
Environment=DDS_IFACE=eth0
Environment=PERIOD=3.0
# GPS from the IR1101 (gps/go2_nmea_reader.py): its NMEA stream, accepted only from the router.
# On the IR1101: lte gps nmea ip udp 192.168.123.1 192.168.123.18 10110
# The router ignores that source address and sends from its Loopback0, 10.20.0.1 (measured
# 2026-10-07: every datagram came from it with 192.168.123.1 configured), so that is the filter.
Environment=NMEA_PORT=10110
Environment=NMEA_SOURCE=10.20.0.1
ExecStart=/home/unitree/robot-telemetry-agent/run.sh
Restart=always
RestartSec=5
# Never let the agent compete with the robot's control stack. It only subscribes; it
# publishes to no command topic, so throttling it cannot affect the robot's behaviour.
MemoryMax=256M
CPUQuota=25%
Nice=10
[Install]
WantedBy=multi-user.target
